#!/bin/bash
# Weekly recruiter email draft creator
# Runs via launchd, invokes Claude Code to search Gmail and create drafts

export PATH="/Users/willy/.nvm/versions/node/v20.19.4/bin:$PATH"

LOGFILE="/tmp/recruiter-drafts.log"
PROMPT_FILE=$(mktemp /tmp/recruiter-prompt.XXXXXX)

echo "$(date): Starting recruiter draft run" >> "$LOGFILE"

GMAIL_DIR="$HOME/.claude/skills/gmail"
GMAIL="$GMAIL_DIR/.venv/bin/python $GMAIL_DIR/scripts/gmail.py"

# Pull all personal-category inbox mail. Let the LLM filter for real recruiter outreach.
# Keyword filtering was too narrow  -  missed e.g. "Engineering @ Navattic" because the
# subject didn't contain recruiter/role/opportunity/position/hiring.
WINDOW="${RECRUITER_WINDOW:-7d}"
# Broad keyword list. Original was too narrow  -  missed "Engineering @ Navattic"
# because no keyword matched the subject. Added: engineer/engineering, founder,
# reaching out, intro, chat, team, building, contract, swe, sde.
KEYWORDS="(recruiter OR recruiting OR role OR opportunity OR position OR hiring OR engineer OR engineering OR founder OR \"reaching out\" OR \"chat\" OR \"intro\" OR \"team\" OR \"building\" OR contract OR swe OR sde)"
RECRUITER_RESULTS=$($GMAIL read --query "is:inbox newer_than:$WINDOW category:personal $KEYWORDS" --limit 40 --full 2>&1)
# LinkedIn InMails (personalized recruiter messages). These come from
# inmail-hit-reply@linkedin.com regardless of subject. Replies sent to that
# address route back into the LinkedIn thread, so Gmail drafts DO work.
# Don't use a broad from:linkedin.com query - mostly noise (job alerts).
LINKEDIN_INMAIL=$($GMAIL read --query "from:inmail-hit-reply@linkedin.com newer_than:$WINDOW" --limit 20 --full 2>&1)
# Digest notifications (Aritra/Seth "just messaged you"). These don't contain
# the message body - just a link. Include so the LLM can flag them in the
# summary even though they can't be drafted.
LINKEDIN_DIGEST=$($GMAIL read --query "from:messaging-digest-noreply@linkedin.com newer_than:$WINDOW" --limit 10 --full 2>&1)
LINKEDIN_RESULTS="=== INMAILS ===
$LINKEDIN_INMAIL

=== DIGEST NOTIFICATIONS (no body, just flag in summary) ===
$LINKEDIN_DIGEST"

# Build prompt with email data inlined, instructions use literal $
cat > "$PROMPT_FILE" <<EMAILDATA
You are handling a weekly recruiter email triage for Will Smith (willsmithte@gmail.com).

CONTEXT:
- Will is a SWE at Amazon in Canada
- He is NOT actively looking for roles right now
- He is planning to move to the US in 2027 via E-3 visa (his wife wants to stay in Canada at least another year for their second baby, healthcare system comfort, and support network)
- He wants to maintain good relationships with recruiters for when the time comes
- He has been working with Amy Meyer at Aussie Recruit (amy@aussierecruitsf.com) for US roles specifically

Here are the Gmail search results from the past $WINDOW:

=== RECRUITER EMAILS ===
$RECRUITER_RESULTS

=== LINKEDIN JOB MESSAGES ===
$LINKEDIN_RESULTS

EMAILDATA

cat >> "$PROMPT_FILE" <<'INSTRUCTIONS'
TASK:
1. Review the emails above. The list is broad (everything in category:personal), so most of it WON'T be recruiter mail  -  that's expected. Skip:
   - Newsletters, bulk/marketing mail (anything with an unsubscribe link), Mailchimp blasts
   - Transactional mail (flights, banking, GitHub notifications, app notifications, Qantas, etc.)
   - Personal correspondence from friends/family
   - Threads where Will has already replied (check the sent folder if unsure: `~/.claude/skills/gmail/.venv/bin/python ~/.claude/skills/gmail/scripts/gmail.py read --query "in:sent to:SENDER" --limit 3`)

   What COUNTS as recruiter outreach that needs a draft (be inclusive  -  when in doubt, draft):
   - A real human (not noreply@) writing personally about a SWE/engineering role, contract, or opportunity
   - Could be a recruiter, an in-house hiring person, a founder reaching out about engineering, or a follow-up to one of those
   - Subjects may NOT contain "recruiter/role/opportunity"  -  e.g. "Engineering @ COMPANY // …" still counts

2. For every email matching the above, ALWAYS create a draft reply  -  even if the role doesn't fit. A polite decline that keeps the relationship warm is better than silence. Use Bash:
   ~/.claude/skills/gmail/.venv/bin/python ~/.claude/skills/gmail/scripts/gmail.py draft --reply-to MSG_ID --body "reply text"

   Drafts MUST sound like Will actually wrote them. His voice is casual, warm, and personal. NOT corporate or polished.

   VOICE RULES:
   - Casual openers: "Hey" or "Hi", never formal
   - Share genuine reactions naturally, like a friend would
   - Use parenthetical asides for personality
   - Show specific enthusiasm about things that matter to him (not generic praise like "compelling" or "solid fit")
   - Sign off casually: "Thanks a lot", "Cheers", not "Best regards"
   - NEVER use words like: "genuinely compelling", "solid fit", "problem space", "I appreciate the persistence", "exploring new roles"
   - Short, conversational. 3-5 sentences max.
   - NEVER use em dashes (—) or en dashes (–) or double dashes (--). Use a regular hyphen with spaces around it: " - ". Or just use commas/periods.

   PERSONAL CONTEXT to weave in naturally (don't dump all of it - pick what fits):
   - Recently back from parental leave (1st kid born late 2025), getting back into the flow
   - Happy at Amazon for now
   - Planning a US move in 2027 (E-3 visa), so staying put in Canada for a bit
   - Open to the right role down the road, especially anything that lines up with values below

   WHAT WILL CARES ABOUT (if the role aligns with any of these, briefly mention it as why it caught his eye):
   - Working close to the user / customer-focused engineering
   - Full stack / broad skillset, not siloed backend
   - Self-starter environments, high ownership
   - Working closely with product
   - Interesting real-world problems

   IMPORTANT: Always close with a line framing the kind of role Will WOULD move for. Phrase as "the kind of high-ownership role where I can have real impact is exactly what I'd be willing to move for" or similar. This is non-negotiable.
   Tie company-specific praise to Will's values, not to the specific industry. He's not just looking for healthtech or crypto. Don't say things like "if you're still working with healthtech companies". Keep it general about reconnecting.

   READ THE COMPANY: If the recruiter mentions specific things about the team/company that align with Will's values (small team, ex-founders, talking to users, real product ownership, etc.) - call those out by name. Shows Will actually read the email and isn't sending a template.

   ACKNOWLEDGE EFFORT: If the recruiter clearly personalized (mentioned Will's site, a specific project, his GitHub, an essay he wrote, etc.) - open by thanking them for it. E.g. "Thanks for the follow-up, and for actually reading my site!" This is a bigger relationship-builder than the value-prop paragraph.

   IF APOLOGIZING FOR A SLOW REPLY: give a real human reason (e.g. "I've just been on parental leave and getting back into the flow of normal life again"). Never use hollow corporate phrasing like "Sorry for the slow reply" with no context.

   WHEN DECLINING - DO NOT escalate to a call/meeting and DO NOT ask for more material:
   - DO NOT say "Happy to jump on a quick call if you're up for it"
   - DO NOT say "Feel free to send the brief through" or "send me the JD"
   - DO close politely with "would love to reconnect down the line" / "stay in touch for down the road"
   - The goal is to keep the relationship warm, NOT to manufacture a meeting Will doesn't want.

   AVOID over-qualifiers that read as corporate: "for the moment", "at this time", "down the line" stacked together. "Happy at Amazon" beats "happy where I am at Amazon for the moment".

   GOOD EXAMPLE: "Navattic looks like a cool product, and the team setup (small, lots of ex-founders, real product ownership, talking to users) is absolutely the kind of environment I care about."
   BAD EXAMPLE: "The role sounds compelling and would be a solid fit."

   FULL EXAMPLE (warm, role aligns - reply to Neil at Navattic):
   "Hey Neil,

   Thanks for the follow-up, and for actually reading my site! Sorry for the delayed response, I've just been on parental leave and getting back into the flow of normal life again.
   Navattic looks like a cool product, and the team setup (small, lots of ex-founders, real product ownership, talking to users) is absolutely the kind of environment I care about. Right now I'm not actively looking - happy at Amazon and have some personal stuff (planning a US move in 2027) that keeps me put for a bit - but I'd love to stay in touch for down the road. This kind of high-ownership role where I can have real impact is exactly what I would be willing to move for.

   Thanks a lot,
   Will"

   FULL EXAMPLE (declining, role doesn't fit - reply to Elena):
   "Hey Elena,

   Thanks for reaching out. I'm not actively looking right now - happy at Amazon and have some personal stuff (planning a US move in 2027) that's keeping me in place for a bit. That said, I'm always open to hearing about high-ownership roles where I can have real impact and work close to the customer, so would love to reconnect down the line.

   Cheers,
   Will"

3. After processing, send a push notification via Bash:
   API_KEY=$(grep NOTIFICATIONS_API_KEY ~/.zshrc | tail -1 | sed "s/^export NOTIFICATIONS_API_KEY=//;s/^'//;s/'$//")
   curl -s -X POST https://willsmithte.com/resource/notifications \
     -H 'Content-Type: application/json' \
     -H 'User-Agent: Mozilla/5.0' \
     -H "Authorization: Bearer $API_KEY" \
     --data-binary "$(jq -n --arg title "Recruiter Drafts" --arg body "YOUR SUMMARY HERE" '{title: $title, body: $body}')"

   Include in the summary:
   - How many recruiter emails found
   - How many drafts created
   - Brief description of each draft (who from, what role)
   - If none found: "No recruiter emails to handle this week"

4. If any drafts were created, also email Will a summary so he knows to check his drafts:
   ~/.claude/skills/gmail/.venv/bin/python ~/.claude/skills/gmail/scripts/gmail.py send --to "willsmithte@gmail.com" --subject "Recruiter drafts ready to review" --body "SUMMARY OF DRAFTS"
   Include who each draft is to, what role/company, and a reminder to review and send them from Gmail drafts.
INSTRUCTIONS

claude --print --dangerously-skip-permissions --allowed-tools "Bash" -p "$(cat "$PROMPT_FILE")" >> "$LOGFILE" 2>&1

rm -f "$PROMPT_FILE"
echo "$(date): Finished recruiter draft run" >> "$LOGFILE"
