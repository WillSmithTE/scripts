#!/bin/zsh
# Resize Chrome window to perfect 9:16 aspect ratio for YouTube Shorts recording
# Records as 1144x2034 (9:16) on Retina display

osascript -e 'tell application "System Events" to tell process "Google Chrome" to set position of front window to {100, 25}' \
        -e 'tell application "System Events" to tell process "Google Chrome" to set size of front window to {534, 948}'
echo "Chrome resized to 9:16 (Shorts-ready)"
